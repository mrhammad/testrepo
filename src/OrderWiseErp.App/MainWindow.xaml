<Window x:Class="OrderWiseErp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:OrderWiseErp.App.Models"
        mc:Ignorable="d"
        Title="OrderWise ERP - Phase 1 MVP"
        Width="1300"
        Height="780"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type models:ModuleInfo}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderThickness="1"
                        BorderBrush="#E5E7EB"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="#6B7280" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Screens}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Planned Screen" Binding="{Binding}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2"
                           Margin="0,10,0,0"
                           Foreground="#6B7280"
                           Text="MVP placeholders only. Wire commands and persistence in next phase." />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F8FAFC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock Text="OrderWise ERP" FontSize="22" FontWeight="SemiBold" Foreground="#E5E7EB" />
                    <TextBlock Text="WPF Phase 1 Scaffold" FontSize="13" Foreground="#9CA3AF" Margin="0,2,0,0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Modules}"
                         SelectedItem="{Binding SelectedModule}"
                         BorderThickness="0"
                         Background="Transparent"
                         DisplayMemberPath="Name">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Foreground" Value="#E5E7EB" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#223B82F6" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2E3B82F6" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="24">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="{Binding CurrentTitle}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CurrentSubtitle}" Foreground="#6B7280" />
            </StackPanel>
            <ContentControl Content="{Binding SelectedModule}" />
        </DockPanel>
    </Grid>
</Window>
