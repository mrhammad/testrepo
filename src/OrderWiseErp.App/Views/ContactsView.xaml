<UserControl x:Class="OrderWiseErp.App.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:l10n="clr-namespace:OrderWiseErp.App.Infrastructure"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox Width="120"
                                  ItemsSource="{Binding ContactTypeFilters}"
                                  SelectedItem="{Binding SelectedTypeFilter}" />
                        <TextBox Width="220"
                                 Margin="8,0,0,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ContactsView}"
                              SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l10n:L10n Common.Type}" Binding="{Binding ContactType}" Width="90" />
                            <DataGridTextColumn Header="{l10n:L10n Contacts.BusinessName}" Binding="{Binding BusinessName}" Width="*" />
                            <DataGridTextColumn Header="{l10n:L10n Common.Name}" Binding="{Binding FullName}" Width="170" />
                            <DataGridTextColumn Header="{l10n:L10n Common.Email}" Binding="{Binding Email}" Width="180" />
                            <DataGridTextColumn Header="{l10n:L10n Common.Mobile}" Binding="{Binding Mobile}" Width="130" />
                            <DataGridTextColumn Header="{l10n:L10n Contacts.Opening}" Binding="{Binding OpeningBalance, StringFormat=N2}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{l10n:L10n Common.Type}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  Margin="8,0,0,8"
                                  ItemsSource="{Binding ContactTypes}"
                                  SelectedItem="{Binding EditContactType}" />

                        <TextBlock Grid.Row="1" Text="{l10n:L10n Common.Category}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="8,0,0,8"
                                  ItemsSource="{Binding ContactCategories}"
                                  SelectedItem="{Binding EditContactCategory}" />

                        <TextBlock Grid.Row="2" Text="{l10n:L10n Contacts.BusinessName}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditBusinessName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Text="{l10n:L10n Contacts.TitleLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Text="{l10n:L10n Contacts.FirstName}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditFirstName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="5" Text="{l10n:L10n Contacts.LastName}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditLastName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="6" Text="{l10n:L10n Common.Email}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="6"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="7" Text="{l10n:L10n Common.Mobile}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="7"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditMobile, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="8" Text="{l10n:L10n Common.Phone}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="8"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="9" Text="{l10n:L10n Contacts.AccountNo}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="9"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditAccountNo, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="10" Text="{l10n:L10n Contacts.Website}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="10"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditWebsite, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="11" Text="{l10n:L10n Contacts.BillingAddress}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="11"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditBillingAddress, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="12" Text="{l10n:L10n Contacts.City}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="12"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditCity, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="13" Text="{l10n:L10n Contacts.Province}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="13"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditProvince, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="14" Text="{l10n:L10n Contacts.PostalCode}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="14"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditPostalCode, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="15" Text="{l10n:L10n Contacts.Country}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="15"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditCountry, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="16" Text="{l10n:L10n Contacts.Bataka}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="16"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditBatakaNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="17" Text="{l10n:L10n Contacts.BusinessLicense}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="17"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditBusinessLicenseNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="18" Text="{l10n:L10n Contacts.VatNumber}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="18"
                                 Grid.Column="1"
                                 Margin="8,0,0,8"
                                 Text="{Binding EditVatNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Grid.Row="19" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{l10n:L10n Common.TermDays}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Margin="8,0,0,0"
                                     Text="{Binding EditPaymentTermDays, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="3"
                                       Text="{l10n:L10n Contacts.CreditLimit}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                            <TextBox Grid.Column="4"
                                     Margin="8,0,0,0"
                                     Text="{Binding EditCreditLimit, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Grid.Row="20" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{l10n:L10n Contacts.OpeningBalance}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Margin="8,0,0,8"
                                     Text="{Binding EditOpeningBalance, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Text="{l10n:L10n Common.Notes}" VerticalAlignment="Top" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="8,0,0,8"
                                     MinHeight="64"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="{l10n:L10n Common.Add}" Command="{Binding AddCommand}" />
                                <Button Content="{l10n:L10n Common.Update}"
                                        Command="{Binding UpdateCommand}"
                                        Margin="8,0,0,0" />
                                <Button Content="{l10n:L10n Common.Delete}"
                                        Command="{Binding DeleteCommand}"
                                        Margin="8,0,0,0" />
                                <Button Content="{l10n:L10n Common.New}"
                                        Command="{Binding ClearFormCommand}"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource MutedTextBrush}" />
    </Grid>
</UserControl>
