<UserControl x:Class="OrderWiseErp.App.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox Width="120"
                                  ItemsSource="{Binding ContactTypeFilters}"
                                  SelectedItem="{Binding SelectedTypeFilter}" />
                        <TextBox Width="220"
                                 Margin="8,0,0,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ContactsView}"
                              SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding ContactType}" Width="90" />
                            <DataGridTextColumn Header="Business Name" Binding="{Binding BusinessName}" Width="*" />
                            <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="170" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180" />
                            <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" Width="130" />
                            <DataGridTextColumn Header="Opening" Binding="{Binding OpeningBalance, StringFormat=N2}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Type" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              Margin="8,0,0,8"
                              ItemsSource="{Binding ContactTypes}"
                              SelectedItem="{Binding EditContactType}" />

                    <TextBlock Grid.Row="1" Text="Business Name" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Margin="8,0,0,8"
                             Text="{Binding EditBusinessName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Text="First Name" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Margin="8,0,0,8"
                             Text="{Binding EditFirstName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Text="Last Name" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             Margin="8,0,0,8"
                             Text="{Binding EditLastName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Text="Email" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             Margin="8,0,0,8"
                             Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Text="Mobile" VerticalAlignment="Center" />
                    <TextBox Grid.Row="5"
                             Grid.Column="1"
                             Margin="8,0,0,8"
                             Text="{Binding EditMobile, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Text="Opening Balance" VerticalAlignment="Center" />
                    <TextBox Grid.Row="6"
                             Grid.Column="1"
                             Margin="8,0,0,8"
                             Text="{Binding EditOpeningBalance, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Row="8"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Add" Command="{Binding AddCommand}" />
                        <Button Content="Update"
                                Command="{Binding UpdateCommand}"
                                Margin="8,0,0,0" />
                        <Button Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Margin="8,0,0,0" />
                        <Button Content="New"
                                Command="{Binding ClearFormCommand}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource MutedTextBrush}" />
    </Grid>
</UserControl>
