<UserControl x:Class="OrderWiseErp.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l10n="clr-namespace:OrderWiseErp.App.Infrastructure"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="{l10n:L10n Common.New}" Command="{Binding ClearFormCommand}" />
                <Button Content="{l10n:L10n Common.Save}" Command="{Binding AddOrUpdateCommand}" Margin="8,0,0,0" />
                <Button Content="{l10n:L10n Common.Delete}" Command="{Binding DeleteCommand}" Margin="8,0,0,0" />
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Projects}"
                      SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l10n:L10n Projects.ProjectNo}" Binding="{Binding ProjectNo}" Width="140" />
                    <DataGridTextColumn Header="{l10n:L10n Common.Name}" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="{l10n:L10n Common.Description}" Binding="{Binding Description}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="2"
                Padding="14"
                Background="White"
                BorderThickness="1"
                BorderBrush="#E5E7EB"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{l10n:L10n Projects.ProjectNo}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Margin="8,0,0,8" Text="{Binding ProjectNo, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Text="{l10n:L10n Common.Name}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Text="{l10n:L10n Common.Description}" VerticalAlignment="Top" />
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Margin="8,0,0,8"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         Height="92"
                         TextWrapping="Wrap" />

                <TextBlock Grid.Row="3" Text="{l10n:L10n Projects.StartDate}" VerticalAlignment="Center" />
                <DatePicker Grid.Row="3" Grid.Column="1" Margin="8,0,0,8" SelectedDate="{Binding StartDate, Mode=TwoWay}" />

                <TextBlock Grid.Row="4" Text="{l10n:L10n Projects.EndDate}" VerticalAlignment="Center" />
                <DatePicker Grid.Row="4" Grid.Column="1" Margin="8,0,0,8" SelectedDate="{Binding EndDate, Mode=TwoWay}" />

                <TextBlock Grid.Row="5"
                           Grid.ColumnSpan="2"
                           Margin="0,8,0,0"
                           Foreground="#6B7280"
                           Text="{Binding LastAction}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
