<UserControl x:Class="OrderWiseErp.App.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Sales Invoices">
            <DataGrid ItemsSource="{Binding Sales}"
                      SelectedItem="{Binding SelectedSale}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNo}" Width="120" />
                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectNo}" Width="120" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="120" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=N2}" Width="110" />
                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <Border Grid.Column="2"
                Padding="14"
                Background="White"
                BorderThickness="1"
                BorderBrush="#E5E7EB"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Invoice #" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Margin="8,0,14,0"
                             Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Column="2" Text="Date" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="3"
                                Margin="8,0,0,0"
                                SelectedDate="{Binding SaleDate, Mode=TwoWay}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Project" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              Margin="8,0,14,0"
                              ItemsSource="{Binding Projects}"
                              DisplayMemberPath="ProjectNo"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedProjectId}" />

                    <TextBlock Grid.Column="2" Text="Customer" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding Customers}"
                              DisplayMemberPath="BusinessName"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedCustomerId}" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Term Days" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="8,0,14,0" Text="{Binding TermDaysInput, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="Due Date" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="3" Margin="8,0,0,0" SelectedDate="{Binding DueDateInput}" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PO / SOC" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding PoNumberInput, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <GroupBox Grid.Row="4" Header="Add Line Item" Margin="0,0,0,10">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Product" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  Margin="8,0"
                                  ItemsSource="{Binding Products}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedProductId}" />
                        <TextBox Grid.Column="2"
                                 Margin="8,0"
                                 Text="{Binding QtyInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="3"
                                 Margin="8,0"
                                 Text="{Binding RateInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="4"
                                 Margin="8,0"
                                 Text="{Binding DiscountPercentInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="5"
                                 Margin="8,0"
                                 Text="{Binding VatRateInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="6"
                                 Margin="8,0"
                                 Text="{Binding ItemDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="7"
                                Content="Add Item"
                                Margin="8,0,0,0"
                                Command="{Binding AddItemCommand}" />
                    </Grid>
                </GroupBox>

                <DataGrid Grid.Row="5"
                          ItemsSource="{Binding CurrentItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" />
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Qty, StringFormat=N2}" Width="90" />
                        <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=N2}" Width="90" />
                        <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercent, StringFormat=N2}" Width="90" />
                        <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat=N2}" Width="90" />
                        <DataGridTextColumn Header="VAT %" Binding="{Binding VatRate, StringFormat=N2}" Width="90" />
                        <DataGridTextColumn Header="VAT" Binding="{Binding VatAmount, StringFormat=N2}" Width="90" />
                        <DataGridTextColumn Header="Net" Binding="{Binding NetAmount, StringFormat=N2}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="6" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="New" Command="{Binding NewSaleCommand}" />
                        <Button Content="Remove Item" Margin="8,0,0,0" Command="{Binding RemoveItemCommand}" />
                        <Button Content="Save" Margin="8,0,0,0" Command="{Binding AddOrUpdateSaleCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="Delete" Margin="8,0,0,0" Command="{Binding DeleteSaleCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Subtotal, StringFormat='Subtotal: {0:N2}'}" />
                        <TextBlock Text="{Binding DiscountTotal, StringFormat='Discount: {0:N2}'}" />
                        <TextBlock Text="{Binding VatTotal, StringFormat='VAT: {0:N2}'}" />
                        <TextBlock Text="{Binding TotalAmount, StringFormat='Net Total: {0:N2}'}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
