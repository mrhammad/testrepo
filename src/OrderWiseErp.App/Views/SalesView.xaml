<UserControl x:Class="OrderWiseErp.App.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l10n="clr-namespace:OrderWiseErp.App.Infrastructure"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="{l10n:L10n Sales.ListHeader}">
            <DataGrid ItemsSource="{Binding Sales}"
                      SelectedItem="{Binding SelectedSale}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l10n:L10n Common.InvoiceNo}" Binding="{Binding InvoiceNo}" Width="120" />
                    <DataGridTextColumn Header="{l10n:L10n Common.Project}" Binding="{Binding ProjectNo}" Width="120" />
                    <DataGridTextColumn Header="{l10n:L10n Common.Customer}" Binding="{Binding CustomerName}" Width="*" />
                    <DataGridTextColumn Header="{l10n:L10n Common.Date}" Binding="{Binding Date, StringFormat=d}" Width="120" />
                    <DataGridTextColumn Header="{l10n:L10n Common.Total}" Binding="{Binding TotalAmount, StringFormat=N2}" Width="110" />
                    <DataGridTextColumn Header="{l10n:L10n Common.Balance}" Binding="{Binding Balance, StringFormat=N2}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <Border Grid.Column="2"
                Padding="14"
                Background="White"
                BorderThickness="1"
                BorderBrush="#E5E7EB"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{l10n:L10n Common.InvoiceNo}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Margin="8,0,14,0"
                             Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Column="2" Text="{l10n:L10n Common.Date}" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="3"
                                Margin="8,0,0,0"
                                SelectedDate="{Binding SaleDate, Mode=TwoWay}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{l10n:L10n Common.Project}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              Margin="8,0,14,0"
                              ItemsSource="{Binding Projects}"
                              DisplayMemberPath="ProjectNo"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedProjectId}" />

                    <TextBlock Grid.Column="2" Text="{l10n:L10n Common.Customer}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding Customers}"
                              DisplayMemberPath="BusinessName"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedCustomerId}" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l10n:L10n Common.TermDays}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="8,0,14,0" Text="{Binding TermDaysInput, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="{l10n:L10n Common.DueDate}" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="3" Margin="8,0,0,0" SelectedDate="{Binding DueDateInput}" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l10n:L10n Common.PoSoc}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding PoNumberInput, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <GroupBox Grid.Row="4" Header="{l10n:L10n Sales.AddLineItem}" Margin="0,0,0,10">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{l10n:L10n Common.Product}" Margin="0,0,8,4" />
                        <TextBlock Grid.Column="1" Text="{l10n:L10n Common.Qty}" Margin="0,0,8,4" />
                        <TextBlock Grid.Column="2" Text="{l10n:L10n Common.Unit}" Margin="0,0,8,4" />
                        <TextBlock Grid.Column="3" Text="{l10n:L10n Common.Rate}" Margin="0,0,8,4" />
                        <TextBlock Grid.Column="4" Text="{l10n:L10n Common.DiscountPercent}" Margin="0,0,8,4" />
                        <TextBlock Grid.Column="5" Text="{l10n:L10n Common.VatPercent}" Margin="0,0,8,4" />
                        <TextBlock Grid.Column="6" Text="{l10n:L10n Common.Description}" Margin="0,0,8,4" />

                        <ComboBox Grid.Row="1"
                                  Grid.Column="0"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding Products}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedProductId}" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,0,8,0"
                                 Text="{Binding QtyInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="2"
                                 Margin="0,0,8,0"
                                 Text="{Binding UnitInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="3"
                                 Margin="0,0,8,0"
                                 Text="{Binding RateInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="4"
                                 Margin="0,0,8,0"
                                 Text="{Binding DiscountPercentInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="5"
                                 Margin="0,0,8,0"
                                 Text="{Binding VatRateInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="6"
                                 Margin="0,0,8,0"
                                 Text="{Binding ItemDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="1"
                                Grid.Column="7"
                                MinWidth="88"
                                Content="{l10n:L10n Common.Add}"
                                Command="{Binding AddItemCommand}" />
                    </Grid>
                </GroupBox>

                <DataGrid Grid.Row="5"
                          ItemsSource="{Binding CurrentItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l10n:L10n Products.Sku}" Binding="{Binding Sku}" Width="90" />
                        <DataGridTextColumn Header="{l10n:L10n Common.Name}" Binding="{Binding ProductName}" Width="1.6*" />
                        <DataGridTextColumn Header="{l10n:L10n Common.Description}" Binding="{Binding Description}" Width="1.8*" />
                        <DataGridTextColumn Header="{l10n:L10n Common.Qty}" Binding="{Binding Qty, StringFormat=N2}" Width="72" />
                        <DataGridTextColumn Header="{l10n:L10n Common.Unit}" Binding="{Binding Unit}" Width="64" />
                        <DataGridTextColumn Header="{l10n:L10n Common.Rate}" Binding="{Binding Rate, StringFormat=N2}" Width="82" />
                        <DataGridTextColumn Header="{l10n:L10n Common.Amount}" Binding="{Binding Amount, StringFormat=N2}" Width="86" />
                        <DataGridTextColumn Header="{l10n:L10n Common.DiscountPercent}" Binding="{Binding DiscountPercent, StringFormat=N2}" Width="76" />
                        <DataGridTextColumn Header="{l10n:L10n Common.Discount}" Binding="{Binding DiscountAmount, StringFormat=N2}" Width="82" />
                        <DataGridTextColumn Header="{l10n:L10n Common.VatPercent}" Binding="{Binding VatRate, StringFormat=N2}" Width="76" />
                        <DataGridTextColumn Header="{l10n:L10n Common.Vat}" Binding="{Binding VatAmount, StringFormat=N2}" Width="82" />
                        <DataGridTextColumn Header="{l10n:L10n Common.Net}" Binding="{Binding NetAmount, StringFormat=N2}" Width="92" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="6" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{l10n:L10n Common.New}" Command="{Binding NewSaleCommand}" />
                        <Button Content="{l10n:L10n Common.RemoveItem}" Margin="8,0,0,0" Command="{Binding RemoveItemCommand}" />
                        <Button Content="{l10n:L10n Common.Save}" Margin="8,0,0,0" Command="{Binding AddOrUpdateSaleCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="{l10n:L10n Common.Delete}" Margin="8,0,0,0" Command="{Binding DeleteSaleCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                        <TextBlock>
                            <Run Text="{l10n:L10n Sales.Subtotal}" />
                            <Run Text=": " />
                            <Run Text="{Binding Subtotal, Mode=OneWay, StringFormat=N2}" />
                        </TextBlock>
                        <TextBlock>
                            <Run Text="{l10n:L10n Common.Discount}" />
                            <Run Text=": " />
                            <Run Text="{Binding DiscountTotal, Mode=OneWay, StringFormat=N2}" />
                        </TextBlock>
                        <TextBlock>
                            <Run Text="{l10n:L10n Common.Vat}" />
                            <Run Text=": " />
                            <Run Text="{Binding VatTotal, Mode=OneWay, StringFormat=N2}" />
                        </TextBlock>
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{l10n:L10n Sales.NetTotal}" />
                            <Run Text=": " />
                            <Run Text="{Binding TotalAmount, Mode=OneWay, StringFormat=N2}" />
                        </TextBlock>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
