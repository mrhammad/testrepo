<UserControl x:Class="OrderWiseErp.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Products">
            <DataGrid ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" />
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="90" />
                    <DataGridTextColumn Header="Sale" Binding="{Binding SalePrice, StringFormat=N2}" Width="110" />
                    <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=N2}" Width="110" />
                    <DataGridTextColumn Header="VAT%" Binding="{Binding VatRate, StringFormat=N2}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="Product Form">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SKU" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,8" Text="{Binding SkuInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,8" Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Category" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2,0,8" Text="{Binding CategoryInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Type" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="3"
                              Grid.Column="1"
                              Margin="0,2,0,8"
                              ItemsSource="{Binding ProductTypes}"
                              SelectedItem="{Binding TypeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Stock Asset Acct." VerticalAlignment="Center" />
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             Margin="0,2,0,8"
                             Text="{Binding StockAccountInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Unit" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="5"
                              Grid.Column="1"
                              Margin="0,2,0,8"
                              ItemsSource="{Binding Units}"
                              SelectedItem="{Binding UnitInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Sale Price" VerticalAlignment="Center" />
                    <TextBox Grid.Row="6" Grid.Column="1" Margin="0,2,0,8" Text="{Binding SalePriceInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Cost" VerticalAlignment="Center" />
                    <TextBox Grid.Row="7" Grid.Column="1" Margin="0,2,0,8" Text="{Binding CostInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Sale Disc. (%)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="8"
                             Grid.Column="1"
                             Margin="0,2,0,8"
                             Text="{Binding SaleDiscountInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Purchase Disc. (%)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="9"
                             Grid.Column="1"
                             Margin="0,2,0,8"
                             Text="{Binding PurchaseDiscountInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Weight" VerticalAlignment="Center" />
                    <TextBox Grid.Row="10"
                             Grid.Column="1"
                             Margin="0,2,0,8"
                             Text="{Binding WeightInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="VAT Rate (%)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="11" Grid.Column="1" Margin="0,2,0,8" Text="{Binding VatRateInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="ADT Rate (%)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="12" Grid.Column="1" Margin="0,2,0,8" Text="{Binding AdtRateInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="13" Grid.Column="0" Text="Low Stock" VerticalAlignment="Center" />
                    <TextBox Grid.Row="13" Grid.Column="1" Margin="0,2,0,8" Text="{Binding LowStockLevelInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="14" Grid.Column="0" Text="Bin Location" VerticalAlignment="Center" />
                    <TextBox Grid.Row="14" Grid.Column="1" Margin="0,2,0,8" Text="{Binding BinLocationInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="15" Grid.Column="0" Text="Sales Info / Note" VerticalAlignment="Top" />
                    <TextBox Grid.Row="15"
                             Grid.Column="1"
                             Margin="0,2,0,8"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="64"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding NotesInput, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Row="16" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="New" Margin="0,0,8,0" Command="{Binding NewCommand}" />
                        <Button Content="Save" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
                        <Button Content="Delete" Command="{Binding DeleteCommand}" />
                    </StackPanel>

                    <TextBlock Grid.Row="17"
                               Grid.ColumnSpan="2"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding Message}" />
                </Grid>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
