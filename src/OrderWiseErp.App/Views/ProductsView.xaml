<UserControl x:Class="OrderWiseErp.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:l10n="clr-namespace:OrderWiseErp.App.Infrastructure"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="{l10n:L10n Products.ListHeader}">
            <DataGrid ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l10n:L10n Products.Sku}" Binding="{Binding Sku}" Width="120" />
                    <DataGridTextColumn Header="{l10n:L10n Common.Name}" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="{l10n:L10n Common.Category}" Binding="{Binding Category}" Width="140" />
                    <DataGridTextColumn Header="{l10n:L10n Common.Unit}" Binding="{Binding Unit}" Width="90" />
                    <DataGridTextColumn Header="{l10n:L10n Products.SalePrice}" Binding="{Binding SalePrice, StringFormat=N2}" Width="110" />
                    <DataGridTextColumn Header="{l10n:L10n Products.Cost}" Binding="{Binding Cost, StringFormat=N2}" Width="110" />
                    <DataGridTextColumn Header="{l10n:L10n Common.VatPercent}" Binding="{Binding VatRate, StringFormat=N2}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="{l10n:L10n Products.FormHeader}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{l10n:L10n Products.Sku}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,8" Text="{Binding SkuInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{l10n:L10n Common.Name}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,8" Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{l10n:L10n Common.Category}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2,0,8" Text="{Binding CategoryInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{l10n:L10n Common.Type}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="3"
                              Grid.Column="1"
                              Margin="0,2,0,8"
                              ItemsSource="{Binding ProductTypes}"
                              SelectedItem="{Binding TypeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{l10n:L10n Products.StockAssetAccount}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             Margin="0,2,0,8"
                             Text="{Binding StockAccountInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{l10n:L10n Common.Unit}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="5"
                              Grid.Column="1"
                              Margin="0,2,0,8"
                              ItemsSource="{Binding Units}"
                              SelectedItem="{Binding UnitInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{l10n:L10n Products.SalePrice}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="6" Grid.Column="1" Margin="0,2,0,8" Text="{Binding SalePriceInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{l10n:L10n Products.Cost}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="7" Grid.Column="1" Margin="0,2,0,8" Text="{Binding CostInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{l10n:L10n Products.SaleDiscount}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="8"
                             Grid.Column="1"
                             Margin="0,2,0,8"
                             Text="{Binding SaleDiscountInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{l10n:L10n Products.PurchaseDiscount}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="9"
                             Grid.Column="1"
                             Margin="0,2,0,8"
                             Text="{Binding PurchaseDiscountInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="{l10n:L10n Products.Weight}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="10"
                             Grid.Column="1"
                             Margin="0,2,0,8"
                             Text="{Binding WeightInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="{l10n:L10n Products.VatRate}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="11" Grid.Column="1" Margin="0,2,0,8" Text="{Binding VatRateInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="{l10n:L10n Products.AdtRate}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="12" Grid.Column="1" Margin="0,2,0,8" Text="{Binding AdtRateInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="13" Grid.Column="0" Text="{l10n:L10n Products.LowStock}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="13" Grid.Column="1" Margin="0,2,0,8" Text="{Binding LowStockLevelInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="14" Grid.Column="0" Text="{l10n:L10n Products.BinLocation}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="14" Grid.Column="1" Margin="0,2,0,8" Text="{Binding BinLocationInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="15" Grid.Column="0" Text="{l10n:L10n Products.SalesInfoNote}" VerticalAlignment="Top" />
                    <TextBox Grid.Row="15"
                             Grid.Column="1"
                             Margin="0,2,0,8"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="64"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding NotesInput, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Row="16" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{l10n:L10n Common.New}" Margin="0,0,8,0" Command="{Binding NewCommand}" />
                        <Button Content="{l10n:L10n Common.Save}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
                        <Button Content="{l10n:L10n Common.Delete}" Command="{Binding DeleteCommand}" />
                    </StackPanel>

                    <TextBlock Grid.Row="17"
                               Grid.ColumnSpan="2"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding Message}" />
                </Grid>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
