<UserControl x:Class="OrderWiseErp.App.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:l10n="clr-namespace:OrderWiseErp.App.Infrastructure"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <TabControl>
            <TabItem Header="{l10n:L10n Stock.TabAdjustments}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{l10n:L10n Stock.AdjustmentsList}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{l10n:L10n Stock.FilterFrom}" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding ListFromDate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="{l10n:L10n Stock.FilterTo}" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding ListToDate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="{l10n:L10n Stock.FilterParty}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding PartyNames}"
                                              IsEditable="True"
                                              Text="{Binding ListPartyFilter, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="{l10n:L10n Stock.FilterLocation}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Locations}"
                                              IsEditable="True"
                                              Text="{Binding ListLocationFilter, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <Button Grid.Column="10"
                                        VerticalAlignment="Bottom"
                                        MinWidth="110"
                                        Content="{l10n:L10n Stock.ApplyFilters}"
                                        Command="{Binding ApplyFiltersCommand}" />
                            </Grid>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding StockAdjustments}"
                                      SelectedItem="{Binding SelectedAdjustment}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l10n:L10n Common.Date}" Binding="{Binding Date, StringFormat=d}" Width="110" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.ReferenceNo}" Binding="{Binding ReferenceNo}" Width="120" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.FilterParty}" Binding="{Binding CustomerOrSupplier}" Width="150" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.FilterLocation}" Binding="{Binding Location}" Width="130" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.AdjustmentType}" Binding="{Binding AdjustmentType}" Width="120" />
                                    <DataGridTextColumn Header="{l10n:L10n Common.Total}" Binding="{Binding TotalAmount, StringFormat=N2}" Width="90" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.TotalRecovered}" Binding="{Binding TotalAmountRecovered, StringFormat=N2}" Width="110" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.Reason}" Binding="{Binding Reason}" Width="*" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.AddedBy}" Binding="{Binding AddedBy}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="12"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{l10n:L10n Stock.AdjustmentForm}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l10n:L10n Common.Date}" VerticalAlignment="Center" />
                                <DatePicker Grid.Column="1" Margin="8,0,14,0" SelectedDate="{Binding AdjustmentDate}" />
                                <TextBlock Grid.Column="2" Text="{l10n:L10n Stock.ReferenceNo}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="3" Margin="8,0,0,0" Text="{Binding AdjustmentReferenceNo, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l10n:L10n Stock.FilterLocation}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          Margin="8,0,14,0"
                                          ItemsSource="{Binding Locations}"
                                          IsEditable="True"
                                          Text="{Binding AdjustmentLocation, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="{l10n:L10n Stock.AdjustmentType}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="3"
                                          Margin="8,0,0,0"
                                          ItemsSource="{Binding AdjustmentTypes}"
                                          SelectedItem="{Binding AdjustmentType}" />
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l10n:L10n Stock.FilterParty}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          Margin="8,0,14,0"
                                          ItemsSource="{Binding PartyNames}"
                                          IsEditable="True"
                                          Text="{Binding AdjustmentCustomerOrSupplier, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="{l10n:L10n Stock.AddedBy}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="3" Margin="8,0,0,0" Text="{Binding AdjustmentAddedBy, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <GroupBox Grid.Row="4" Header="{l10n:L10n Stock.LineItems}" Margin="0,0,0,8">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{l10n:L10n Products.Sku}" Margin="0,0,8,4" />
                                    <TextBlock Grid.Column="1" Text="{l10n:L10n Common.Product}" Margin="0,0,8,4" />
                                    <TextBlock Grid.Column="2" Text="{l10n:L10n Common.Qty}" Margin="0,0,8,4" />
                                    <TextBlock Grid.Column="3" Text="{l10n:L10n Stock.UnitPrice}" Margin="0,0,8,4" />

                                    <ComboBox Grid.Row="1"
                                              Grid.Column="0"
                                              Margin="0,0,8,0"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              StaysOpenOnEdit="True"
                                              IsDropDownOpen="{Binding IsAdjustmentSkuSuggestionOpen, Mode=OneWay}"
                                              ItemsSource="{Binding AdjustmentSkuSuggestions}"
                                              Text="{Binding AdjustmentItemSkuInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Row="1"
                                              Grid.Column="1"
                                              Margin="0,0,8,0"
                                              ItemsSource="{Binding ProductNames}"
                                              IsEditable="True"
                                              Text="{Binding AdjustmentItemProductNameInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" Text="{Binding AdjustmentItemQtyInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,8,0" Text="{Binding AdjustmentItemUnitPriceInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Row="1"
                                            Grid.Column="4"
                                            MinWidth="88"
                                            Content="{l10n:L10n Common.Add}"
                                            Command="{Binding AddAdjustmentItemCommand}" />
                                </Grid>
                            </GroupBox>

                            <DataGrid Grid.Row="5"
                                      Height="160"
                                      ItemsSource="{Binding DraftAdjustmentItems}"
                                      SelectedItem="{Binding SelectedAdjustmentItem}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l10n:L10n Products.Sku}" Binding="{Binding Sku}" Width="120" />
                                    <DataGridTextColumn Header="{l10n:L10n Common.Product}" Binding="{Binding ProductName}" Width="*" />
                                    <DataGridTextColumn Header="{l10n:L10n Common.Qty}" Binding="{Binding Qty, StringFormat=N2}" Width="90" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.UnitPrice}" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.SubTotal}" Binding="{Binding SubTotal, StringFormat=N2}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="6" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l10n:L10n Stock.TotalRecovered}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding AdjustmentTotalRecoveredInput, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Grid.Row="7" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l10n:L10n Stock.Reason}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Margin="8,0,0,0"
                                         Text="{Binding AdjustmentReason, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         MinHeight="52"
                                         TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock Grid.Row="8"
                                       Text="{Binding AdjustmentTotalAmount, StringFormat=Total: {0:N2}}"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />

                            <TextBlock Grid.Row="9"
                                       Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />

                            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="{l10n:L10n Common.RemoveItem}" Command="{Binding RemoveAdjustmentItemCommand}" />
                                <Button Content="{l10n:L10n Common.New}" Margin="8,0,0,0" Command="{Binding NewAdjustmentCommand}" />
                                <Button Content="{l10n:L10n Common.Save}" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveAdjustmentCommand}" />
                                <Button Content="{l10n:L10n Common.Delete}" Margin="8,0,0,0" Command="{Binding DeleteAdjustmentCommand}" />
                                <Button Content="{l10n:L10n Stock.SavePrint}" Margin="8,0,0,0" Command="{Binding SavePrintAdjustmentCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{l10n:L10n Stock.TabTransfers}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{l10n:L10n Stock.TransfersList}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{l10n:L10n Stock.FilterFrom}" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding ListFromDate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="{l10n:L10n Stock.FilterTo}" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding ListToDate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="{l10n:L10n Stock.FilterParty}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding PartyNames}"
                                              IsEditable="True"
                                              Text="{Binding ListPartyFilter, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="{l10n:L10n Stock.FilterLocation}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Locations}"
                                              IsEditable="True"
                                              Text="{Binding ListLocationFilter, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <Button Grid.Column="10"
                                        VerticalAlignment="Bottom"
                                        MinWidth="110"
                                        Content="{l10n:L10n Stock.ApplyFilters}"
                                        Command="{Binding ApplyFiltersCommand}" />
                            </Grid>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding StockTransfers}"
                                      SelectedItem="{Binding SelectedTransfer}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l10n:L10n Common.Date}" Binding="{Binding Date, StringFormat=d}" Width="100" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.ReferenceNo}" Binding="{Binding ReferenceNo}" Width="120" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.LocationFrom}" Binding="{Binding LocationFrom}" Width="120" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.LocationTo}" Binding="{Binding LocationTo}" Width="120" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.Status}" Binding="{Binding Status}" Width="110" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.FilterParty}" Binding="{Binding CustomerOrSupplier}" Width="150" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.ShippingCharges}" Binding="{Binding ShippingCharges, StringFormat=N2}" Width="100" />
                                    <DataGridTextColumn Header="{l10n:L10n Common.Total}" Binding="{Binding TotalAmount, StringFormat=N2}" Width="90" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.AdditionalNote}" Binding="{Binding AdditionalNote}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="12"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{l10n:L10n Stock.TransferForm}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l10n:L10n Common.Date}" VerticalAlignment="Center" />
                                <DatePicker Grid.Column="1" Margin="8,0,14,0" SelectedDate="{Binding TransferDate}" />
                                <TextBlock Grid.Column="2" Text="{l10n:L10n Stock.ReferenceNo}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="3" Margin="8,0,0,0" Text="{Binding TransferReferenceNo, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l10n:L10n Stock.Status}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          Margin="8,0,14,0"
                                          ItemsSource="{Binding TransferStatuses}"
                                          SelectedItem="{Binding TransferStatus}" />
                                <TextBlock Grid.Column="2" Text="{l10n:L10n Stock.FilterParty}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="3"
                                          Margin="8,0,0,0"
                                          ItemsSource="{Binding PartyNames}"
                                          IsEditable="True"
                                          Text="{Binding TransferCustomerOrSupplier, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l10n:L10n Stock.LocationFrom}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          Margin="8,0,14,0"
                                          ItemsSource="{Binding Locations}"
                                          IsEditable="True"
                                          Text="{Binding TransferLocationFrom, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="{l10n:L10n Stock.LocationTo}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="3"
                                          Margin="8,0,0,0"
                                          ItemsSource="{Binding Locations}"
                                          IsEditable="True"
                                          Text="{Binding TransferLocationTo, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <GroupBox Grid.Row="4" Header="{l10n:L10n Stock.LineItems}" Margin="0,0,0,8">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{l10n:L10n Products.Sku}" Margin="0,0,8,4" />
                                    <TextBlock Grid.Column="1" Text="{l10n:L10n Common.Product}" Margin="0,0,8,4" />
                                    <TextBlock Grid.Column="2" Text="{l10n:L10n Common.Qty}" Margin="0,0,8,4" />
                                    <TextBlock Grid.Column="3" Text="{l10n:L10n Stock.UnitPrice}" Margin="0,0,8,4" />

                                    <ComboBox Grid.Row="1"
                                              Grid.Column="0"
                                              Margin="0,0,8,0"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              StaysOpenOnEdit="True"
                                              IsDropDownOpen="{Binding IsTransferSkuSuggestionOpen, Mode=OneWay}"
                                              ItemsSource="{Binding TransferSkuSuggestions}"
                                              Text="{Binding TransferItemSkuInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Row="1"
                                              Grid.Column="1"
                                              Margin="0,0,8,0"
                                              ItemsSource="{Binding ProductNames}"
                                              IsEditable="True"
                                              Text="{Binding TransferItemProductNameInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" Text="{Binding TransferItemQtyInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,8,0" Text="{Binding TransferItemUnitPriceInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Row="1"
                                            Grid.Column="4"
                                            MinWidth="88"
                                            Content="{l10n:L10n Common.Add}"
                                            Command="{Binding AddTransferItemCommand}" />
                                </Grid>
                            </GroupBox>

                            <DataGrid Grid.Row="5"
                                      Height="160"
                                      ItemsSource="{Binding DraftTransferItems}"
                                      SelectedItem="{Binding SelectedTransferItem}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l10n:L10n Products.Sku}" Binding="{Binding Sku}" Width="120" />
                                    <DataGridTextColumn Header="{l10n:L10n Common.Product}" Binding="{Binding ProductName}" Width="*" />
                                    <DataGridTextColumn Header="{l10n:L10n Common.Qty}" Binding="{Binding Qty, StringFormat=N2}" Width="90" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.UnitPrice}" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100" />
                                    <DataGridTextColumn Header="{l10n:L10n Stock.SubTotal}" Binding="{Binding SubTotal, StringFormat=N2}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="6" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l10n:L10n Stock.ShippingCharges}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding TransferShippingChargesInput, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Grid.Row="7" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l10n:L10n Stock.AdditionalNote}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Margin="8,0,0,0"
                                         Text="{Binding TransferAdditionalNote, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         MinHeight="52"
                                         TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock Grid.Row="8"
                                       Text="{Binding TransferTotalAmount, StringFormat=Total: {0:N2}}"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />

                            <TextBlock Grid.Row="9"
                                       Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />

                            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="{l10n:L10n Common.RemoveItem}" Command="{Binding RemoveTransferItemCommand}" />
                                <Button Content="{l10n:L10n Common.New}" Margin="8,0,0,0" Command="{Binding NewTransferCommand}" />
                                <Button Content="{l10n:L10n Common.Save}" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveTransferCommand}" />
                                <Button Content="{l10n:L10n Common.Delete}" Margin="8,0,0,0" Command="{Binding DeleteTransferCommand}" />
                                <Button Content="{l10n:L10n Stock.SavePrint}" Margin="8,0,0,0" Command="{Binding SavePrintTransferCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
